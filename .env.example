# ---------------------------------------------------------------------------
# Portfolio CMS environment variables
# Copy to `.env` for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
# Public URL of the site (used for CORS and absolute links)
APP_URL=http://localhost:5173
# Port for the local API server (dev only)
API_PORT=8787

# --- Database --------------------------------------------------------------
# Leave DATABASE_URL empty in development to use the embedded PGlite database
# stored under .data/pglite. In production set a Postgres connection string.
DATABASE_URL=
# Optional override for the embedded database directory (use ":memory:" for tests)
PGLITE_DIR=.data/pglite

# --- Storage ---------------------------------------------------------------
# local (dev) or vercel-blob (production)
STORAGE_DRIVER=local
# Local storage directory and public URL prefix (dev only)
LOCAL_STORAGE_DIR=.data/uploads
LOCAL_STORAGE_PUBLIC_PREFIX=/api/files
# Vercel Blob read/write token (required when STORAGE_DRIVER=vercel-blob)
BLOB_READ_WRITE_TOKEN=
# Blob store access mode: private (default) or public.
# Must match how the store was created; private stores reject public uploads
# and are served through /api/files/* instead.
BLOB_ACCESS=private

# --- Uploads ---------------------------------------------------------------
UPLOAD_MAX_FILE_SIZE=8388608
UPLOAD_MAX_FILES=8
UPLOAD_MAX_TOTAL_SIZE=33554432
UPLOAD_MAX_DIMENSION=8000

# --- Sessions --------------------------------------------------------------
SESSION_IDLE_TTL=604800
SESSION_ABSOLUTE_TTL=2592000

# --- Rate limiting ---------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
CONTACT_MAX_REQUESTS=5
CONTACT_WINDOW_SECONDS=3600
UPLOAD_MAX_REQUESTS=60
UPLOAD_WINDOW_SECONDS=3600

# --- Admin provisioning (used only by `npm run admin:create`) --------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
